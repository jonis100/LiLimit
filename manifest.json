{
  "manifest_version": 3,
  "name": "LiLimit - Set Limits for Distracting Sites (Private & Open Source)",
  "version": "1.4.3",
  "description": "This extension allows you to limit the number of visits per day or the duration of each visit to any website",
  "icons": {
    "16": "images/icons/lily-16.png",
    "32": "images/icons/lily-32.png",
    "48": "images/icons/lily-48.png",
    "128": "images/icons/lily-128.png"
  },
  "permissions": ["tabs", "alarms", "storage", "offscreen"],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "images/icons/lily-16.png",
      "32": "images/icons/lily-32.png",
      "48": "images/icons/lily-48.png",
      "128": "images/icons/lily-128.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["pages/time-exceeded.html", "pages/visits-exceeded.html", "images/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
