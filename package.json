{
  "name": "lilimit",
  "version": "1.4.0",
  "description": "This extension allows you to limit the number of visits per day or the duration of each visit to any website",
  "type": "module",
  "scripts": {
    "copy:static": "mkdir -p dist && cp manifest.json dist/ && cp public/popup.html public/popup.css dist/ && cp -r public/pages dist/ && cp -r public/images dist/",
    "compile": "tsc",
    "build": "npm run copy:static && npm run compile",
    "watch": "npm run copy:static && tsc --watch",
    "clean": "rm -rf dist",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "chrome-extension",
    "typescript",
    "limit",
    "productivity",
    "time-management"
  ],
  "author": "jonis100",
  "license": "MIT"
}
