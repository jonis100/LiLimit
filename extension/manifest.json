{
  "manifest_version": 3,
  "name": "LiLimit",
  "version": "1.3.0",
  "description": "This extension allows you to limit the number of visits per day or the duration of each visit to any website",
  "permissions": ["tabs", "alarms", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": "images/lily.png",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["time-exceeded.html", "visits-exceeded.html", "images/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
